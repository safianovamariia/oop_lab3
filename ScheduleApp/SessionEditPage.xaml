<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScheduleApp.SessionEditPage"
             Title="Record">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8" WidthRequest="520" HorizontalOptions="Center">
            <Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" />

            <Label Text="Record type" FontAttributes="Bold" />
            <Picker x:Name="TypePicker" SelectedIndexChanged="OnTypeChanged" />

            <Label Text="Room / ARM" FontAttributes="Bold" />
            <Picker x:Name="RoomPicker" />

            <Label Text="Day of week" FontAttributes="Bold" />
            <Picker x:Name="DayPicker" />

            <Label Text="Time" FontAttributes="Bold" />
            <Picker x:Name="TimeSlotPicker" />

            <VerticalStackLayout x:Name="LessonFields" Spacing="8">
                <Label Text="Subject" FontAttributes="Bold" />
                <Entry x:Name="SubjectEntry" />
                <Label Text="Group" FontAttributes="Bold" />
                <Entry x:Name="GroupEntry" Placeholder="K-11" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ArmFields" Spacing="8">
                <Label Text="Workplace" FontAttributes="Bold" />
                <Entry x:Name="WorkplaceEntry" Placeholder="ARM-1" />
            </VerticalStackLayout>

            <Label x:Name="PersonLabel" Text="Teacher" FontAttributes="Bold" />
            <Picker x:Name="PersonPicker" />

            <Label x:Name="MessageLabel" TextColor="Red" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Save" Clicked="BtnClickSave" />
                <Button Grid.Column="1" Text="Cancel" Clicked="BtnClickCancel" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
